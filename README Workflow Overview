# STEP 0 - Merge VCF files and filtered to DEG list


############################################################################################################



# STEP 1 - Run PLINK2 to detect variant-level assocation to TB-IRIS with sex and CD4 count as co-variates

plink2 --vcf vep_annotated_deg_variants.vcf.gz \
       --pheno tb_iris_pheno.fid0.tab.txt --pheno-name PHENOTYPE \
       --covar tb_iris_pheno.fid0.tab.txt --covar-name CD4 \
       --update-sex sex_info.fid0.tab.txt \
       --split-par hg38 \
       --glm firth-fallback \
       --out tb_iris_association_results_allchr_CD4



############################################################################################################



# STEP 2 - Clean the output files (remove rows without valid p-values, then remove rows belonging to the ChrY)


awk -F'\t' 'NR==1 || $16 != "NA"' tb_iris_association_results_allchr_CD4.PHENOTYPE.glm.logistic.hybrid > plink_results_valid_pvalues.tsv


awk -F'\t' 'NR == 1 || $1 != "Y"' plink_results_valid_pvalues.tsv > plink_results_valid_pvalues_noY.tsv


# Create a file for the TB-IRIS association results (output = 190766 data rows)

awk -F'\t' 'NR == 1 || $11 == "ADD"' plink_results_valid_pvalues_noY.tsv > plink_results_ADD_test.tsv

 
# Create a file for the CD4 association results (output = 160762 data rows)

awk -F'\t' 'NR == 1 || $11 == "CD4"' plink_results_valid_pvalues_noY.tsv > plink_results_CD4_test.tsv


